{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Strategic choice",
  "description": "Strategiskt vägval baserat på explicit alternativanalys.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "decision_question": {
      "type": "string",
      "minLength": 1
    },
    "goal_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_-]{1,63}$"
      },
      "minItems": 1
    },
    "issue_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_-]{1,63}$"
      },
      "minItems": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_-]{1,63}$"
      },
      "minItems": 1
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "advantages": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "disadvantages": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reversibility": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low",
              "unknown"
            ]
          }
        },
        "required": [
          "name",
          "description",
          "advantages",
          "disadvantages",
          "risks",
          "reversibility"
        ]
      },
      "minItems": 2
    },
    "recommended_direction": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "reversibility": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "evidence_requirement": {
      "type": "string",
      "enum": [
        "normal",
        "elevated",
        "high"
      ]
    },
    "product_neutral": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "id",
    "name",
    "decision_question",
    "goal_ids",
    "evidence_ids",
    "alternatives",
    "recommended_direction",
    "rationale",
    "reversibility",
    "evidence_requirement",
    "product_neutral"
  ]
}
